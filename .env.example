# MinIO (docker compose). Copy to .env: cp .env.example .env
# Never commit a real .env with production secrets.

# --- Host-exposed ports (used by `docker compose` and `website` Vite dev proxy) ---
# Change these if a port is already in use. Inside Docker, the app ports stay 3000 / 4000 / 8080.
AGF_KERNEL_HOST_PORT=3036
CONTROL_PLANE_HOST_PORT=4046
WEBSITE_HOST_PORT=8088
# Read-only community catalog HTTP API (Phase B; website nginx → /catalog/…; Vite dev proxy)
CATALOG_HOST_PORT=4055
MINIO_S3_API_HOST_PORT=9000
MINIO_S3_CONSOLE_HOST_PORT=9001
# If 9000/9001 are already bound (another MinIO), use e.g. 19000 / 19001.

MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin

# Create a bucket in the MinIO console (e.g. agf). Reserved for when the control plane
# supports S3 uploads — not read by the app yet:
# AGF_S3_BUCKET=agf

# --- docker compose (control-plane service) ---------------------------------
# HS256 for user/org login tokens; set a long random value in any shared environment
CONTROL_PLANE_JWT_SECRET=dev-docker-compose-change-in-prod-32ch
# Local compose overrides the image NODE_ENV=production default so SKIP_ARSL / weak secrets are allowed.
# CONTROL_PLANE_NODE_ENV=development
# Seed demo customer/bundle/approvals when the SQLite volume is empty:
# CONTROL_PLANE_SEED_DEV_DATA=1
# Bootstrap first admin (only when users table is empty):
# CONTROL_PLANE_BOOTSTRAP_EMAIL=e2e@agf.local
# CONTROL_PLANE_BOOTSTRAP_PASSWORD=e2e-test-password-16ch
# CONTROL_PLANE_BOOTSTRAP_CUSTOMER=cust_dev
# 1 = allow unauthenticated API access for local-only development. Never enable outside dev.
# CONTROL_PLANE_ALLOW_INSECURE_NO_AUTH=1
# 1 = seed default dev customer, bundle, and sample approvals on an empty DB.
# CONTROL_PLANE_SEED_DEV_DATA=1
# 1 = re-enable legacy short-path APIs that fall back to DEFAULT_CUSTOMER_ID.
# CONTROL_PLANE_ENABLE_LEGACY_DEFAULT_PATHS=1
# 1 = skip arsl-validate on publish (no Rust binary in the container unless you build it and mount a target/ path)
CONTROL_PLANE_SKIP_ARSL_VALIDATE=1
# Optional explicit browser origins for cross-origin API access. Leave unset for same-origin only.
# CONTROL_PLANE_CORS_ORIGINS=https://ops.example.com,https://admin.example.com
# Optional bearer API key alternative to JWT auth. Use a long random value in shared environments.
# CONTROL_PLANE_API_KEY=replace-with-long-random-api-key
# Optional customer used by open registration when enabled.
# CONTROL_PLANE_OPEN_REGISTRATION_CUSTOMER=cust_dev

# --- Rate limiting (control-plane; in-process sliding window) -----------------
# Defaults: API 120 req/min/IP, auth endpoints 20 req/min/IP. Set RATE_LIMIT=0 to disable
# (only when another gateway already enforces limits).
# CONTROL_PLANE_RATE_LIMIT=0
# CONTROL_PLANE_RATE_LIMIT_WINDOW_MS=60000
# CONTROL_PLANE_RATE_LIMIT_MAX=120
# CONTROL_PLANE_AUTH_RATE_LIMIT_WINDOW_MS=60000
# CONTROL_PLANE_AUTH_RATE_LIMIT_MAX=20

# If you run the control plane on the host (npm) but the kernel only in Docker, set the kernel host URL (match AGF_KERNEL_HOST_PORT):
# AGF_KERNEL_URL=http://127.0.0.1:3036
# (In full compose, leave unset — the API uses http://agf-kernel:3000 inside the network.)

# Optional enterprise extension module for control-plane startup (absolute path
# or path relative to where you start `npm run dev`):
# AGF_ENTERPRISE_MODULE=/absolute/path/to/agf-enterprise/dist/control-plane-plugin.mjs
